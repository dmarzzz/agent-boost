{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-boost:schema:tool-result:v1",
  "title": "Agent Boost tool result envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "manifest_digest",
    "outcome",
    "code",
    "retry",
    "data"
  ],
  "properties": {
    "schema": {"const": "org.agentboost.tool-result"},
    "schema_version": {"const": "1.0"},
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "ready",
        "blocked",
        "awaiting_funding",
        "executing",
        "submitted",
        "confirmed",
        "failed",
        "indeterminate"
      ]
    },
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "safe_with_same_arguments"],
      "properties": {
        "mode": {"enum": ["never", "wait", "refresh_plan"]},
        "after_ms": {"type": "integer", "minimum": 0},
        "safe_with_same_arguments": {"type": "boolean"}
      }
    },
    "data": {"type": "object"}
  }
}
