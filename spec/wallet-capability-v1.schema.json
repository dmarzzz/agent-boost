{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-boost:schema:wallet-capability:v1",
  "title": "Agent Boost wallet capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "chain_id",
    "network_name",
    "asset_type",
    "funding_target_atomic",
    "privacy_protocol",
    "private_payment_operation",
    "authority",
    "privacy",
    "adapters",
    "readiness"
  ],
  "properties": {
    "contract": {"const": "org.agentboost.wallet/1.0"},
    "chain_id": {"const": "eip155:11155111"},
    "network_name": {"const": "Sepolia"},
    "asset_type": {"const": "eip155:11155111/slip44:60"},
    "funding_target_atomic": {"$ref": "#/$defs/atomic"},
    "privacy_protocol": {"const": "tornado"},
    "private_payment_operation": {"const": "unshield_next_tail_call"},
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "can_cause_signing",
        "mainnet_available",
        "per_payment_limit_atomic",
        "lifetime_limit_atomic",
        "max_payments",
        "requires_exact_verbal_confirmation"
      ],
      "properties": {
        "mode": {"const": "testnet_delegated"},
        "can_cause_signing": {"const": true},
        "mainnet_available": {"const": false},
        "per_payment_limit_atomic": {"$ref": "#/$defs/atomic"},
        "lifetime_limit_atomic": {"$ref": "#/$defs/atomic"},
        "max_payments": {"const": 1},
        "requires_exact_verbal_confirmation": {"const": true}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "hides_direct_deposit_withdrawal_link",
        "guarantees_anonymity",
        "rpc_egress_private",
        "funding_source_private",
        "limitations"
      ],
      "properties": {
        "claim": {"const": "privacy-improving shielded Sepolia test payment"},
        "hides_direct_deposit_withdrawal_link": {"type": "boolean"},
        "guarantees_anonymity": {"const": false},
        "rpc_egress_private": {"const": false},
        "funding_source_private": {"const": false},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet", "egress"],
      "properties": {
        "wallet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "compatible_commit"],
          "properties": {
            "name": {"const": "kohaku"},
            "compatible_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "available", "stage"],
          "properties": {
            "name": {"const": "shade-tree"},
            "available": {"const": false},
            "stage": {"const": "next"}
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "wallet_ready", "address_ready", "egress_ready"],
      "properties": {
        "phase": {
          "enum": [
            "not_started",
            "creating_wallet",
            "preparing_privacy",
            "awaiting_funding",
            "funding_pending",
            "funded_public",
            "shielding",
            "private_ready",
            "failed"
          ]
        },
        "wallet_ready": {"type": "boolean"},
        "address_ready": {"type": "boolean"},
        "egress_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "atomic": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
