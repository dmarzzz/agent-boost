{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-boost:schema:wallet-capability:v1",
  "title": "Agent Boost wallet capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "chain_id",
    "network_name",
    "asset_type",
    "funding_target_atomic",
    "privacy_protocol",
    "private_payment_operation",
    "authority",
    "security",
    "privacy",
    "adapters",
    "readiness",
    "demo_reset",
    "wallet_management"
  ],
  "properties": {
    "contract": {"const": "org.agentboost.wallet/1.4"},
    "chain_id": {"const": "eip155:11155111"},
    "network_name": {"const": "Sepolia"},
    "asset_type": {"const": "eip155:11155111/slip44:60"},
    "funding_target_atomic": {"$ref": "#/$defs/atomic"},
    "privacy_protocol": {"const": "tornado"},
    "private_payment_operation": {"const": "unshield_next_tail_call"},
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "can_cause_signing",
        "mainnet_available",
        "per_payment_limit_atomic",
        "lifetime_limit_atomic",
        "max_payments",
        "default_lifetime_seconds",
        "requires_exact_verbal_confirmation",
        "requires_user_confirmation",
        "policy_editing"
      ],
      "properties": {
        "mode": {"const": "testnet_delegated"},
        "can_cause_signing": {"const": true},
        "mainnet_available": {"const": false},
        "per_payment_limit_atomic": {"$ref": "#/$defs/atomic"},
        "lifetime_limit_atomic": {"$ref": "#/$defs/atomic"},
        "max_payments": {"type": "integer", "minimum": 1, "maximum": 100},
        "default_lifetime_seconds": {"type": "integer", "minimum": 1},
        "requires_exact_verbal_confirmation": {"const": false},
        "requires_user_confirmation": {"type": "boolean"},
        "policy_editing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "requires_user_confirmation",
            "hard_max_per_payment_atomic",
            "hard_max_lifetime_atomic",
            "hard_max_payments",
            "hard_max_lifetime_seconds"
          ],
          "properties": {
            "available": {"const": true},
            "requires_user_confirmation": {"const": true},
            "hard_max_per_payment_atomic": {"$ref": "#/$defs/atomic"},
            "hard_max_lifetime_atomic": {"$ref": "#/$defs/atomic"},
            "hard_max_payments": {"const": 100},
            "hard_max_lifetime_seconds": {"const": 2592000}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "overrides", "effective", "hard_limits"],
      "properties": {
        "default": {"$ref": "#/$defs/securityDefaults"},
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payment.execute": {"$ref": "#/$defs/paymentApproval"}
          }
        },
        "effective": {"$ref": "#/$defs/securityRules"},
        "hard_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain_id",
            "mainnet_available",
            "rpc_direct_fallback",
            "per_payment_limit_atomic",
            "lifetime_limit_atomic",
            "max_payments"
          ],
          "properties": {
            "chain_id": {"const": "eip155:11155111"},
            "mainnet_available": {"const": false},
            "rpc_direct_fallback": {"const": false},
            "per_payment_limit_atomic": {"$ref": "#/$defs/atomic"},
            "lifetime_limit_atomic": {"$ref": "#/$defs/atomic"},
            "max_payments": {"const": 100}
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "hides_direct_deposit_withdrawal_link",
        "guarantees_anonymity",
        "rpc_egress",
        "general_agent_egress_private",
        "funding_source_private",
        "limitations"
      ],
      "properties": {
        "claim": {"const": "privacy-improving shielded Sepolia test payment"},
        "hides_direct_deposit_withdrawal_link": {"type": "boolean"},
        "guarantees_anonymity": {"const": false},
        "rpc_egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "scope",
            "covers",
            "dns_resolution",
            "direct_fallback",
            "hides_origin_ip_from_rpc_provider",
            "hides_rpc_activity_from_provider"
          ],
          "properties": {
            "mode": {"const": "tor"},
            "scope": {"const": "ethereum_json_rpc"},
            "covers": {
              "const": ["agent_boost", "kohaku"]
            },
            "dns_resolution": {"const": "tor_exit"},
            "direct_fallback": {"const": false},
            "hides_origin_ip_from_rpc_provider": {"const": true},
            "hides_rpc_activity_from_provider": {"const": false}
          }
        },
        "general_agent_egress_private": {"const": false},
        "funding_source_private": {"const": false},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet", "rpc_egress", "general_egress"],
      "properties": {
        "wallet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "compatible_commit"],
          "properties": {
            "name": {"const": "kohaku"},
            "compatible_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "rpc_egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "available", "scope", "direct_fallback"],
          "properties": {
            "name": {"const": "tor-js"},
            "available": {"const": true},
            "scope": {"const": "ethereum_json_rpc"},
            "direct_fallback": {"const": false}
          }
        },
        "general_egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "available", "contract", "mode", "status", "direct_fallback"],
          "properties": {
            "name": {"const": "shade-tree"},
            "available": {"type": "boolean"},
            "contract": {"const": "org.agentboost.egress/0.1"},
            "mode": {"const": "explicit_fetch"},
            "status": {
              "enum": ["disabled", "not_installed", "needs_enrollment", "starting", "ready", "degraded", "exhausted", "failed"]
            },
            "direct_fallback": {"const": false}
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "wallet_ready", "address_ready", "rpc_egress", "general_egress_ready"],
      "properties": {
        "phase": {
          "enum": [
            "not_started",
            "creating_wallet",
            "preparing_privacy",
            "awaiting_funding",
            "funding_pending",
            "funded_public",
            "shielding",
            "private_ready",
            "failed"
          ]
        },
        "wallet_ready": {"type": "boolean"},
        "address_ready": {"type": "boolean"},
        "rpc_egress": {"enum": ["starting", "ready", "failed", "closed"]},
        "general_egress_ready": {"type": "boolean"}
      }
    },
    "demo_reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "requires_user_confirmation",
        "archives_previous_state",
        "rebroadcasts_unresolved_payments"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "requires_user_confirmation": {"const": true},
        "archives_previous_state": {"const": true},
        "rebroadcasts_unresolved_payments": {"const": false}
      }
    },
    "wallet_management": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "managed_wallets_only",
        "accepts_seed_or_password",
        "selection_requires_separate_reauthorization",
        "recovery_transfer_available"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "managed_wallets_only": {"const": true},
        "accepts_seed_or_password": {"const": false},
        "selection_requires_separate_reauthorization": {"const": true},
        "recovery_transfer_available": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "paymentApproval": {
      "enum": ["allow", "confirm", "deny"]
    },
    "securityDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet.read", "payment.plan", "payment.execute"],
      "properties": {
        "wallet.read": {"const": "allow"},
        "payment.plan": {"const": "allow"},
        "payment.execute": {"const": "confirm"}
      }
    },
    "securityRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallet.read", "payment.plan", "payment.execute"],
      "properties": {
        "wallet.read": {"const": "allow"},
        "payment.plan": {"const": "allow"},
        "payment.execute": {"$ref": "#/$defs/paymentApproval"}
      }
    },
    "atomic": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
